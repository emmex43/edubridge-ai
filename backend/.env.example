# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored -- never commit it, and never paste real values
# into scripts, tests, or batch files.

# --- Provider -------------------------------------------------------------
# The backend talks to any OpenAI-compatible API. Leave OPENAI_BASE_URL unset
# to use OpenAI itself, or point it at a gateway:
#   Groq:        https://api.groq.com/openai/v1
#   AgentRouter: https://agentrouter.org/v1
#   OpenRouter:  https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-proj-replace-me
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# --- Models ---------------------------------------------------------------
# Model IDs differ per provider, so they are config rather than hardcoded.
# OpenAI defaults:
#   CHAT_MODEL=gpt-4o  STT_MODEL=whisper-1  TTS_MODEL=tts-1
#   EMBEDDING_MODEL=text-embedding-3-small
# AgentRouter's catalogue is chat-only (claude-opus-5, gpt-5.6-sol, glm-5.3,
# deepseek-v4-flash) and documents no speech or embedding models, so voice and
# RAG only work there if it happens to serve those endpoints.
# CHAT_MODEL=claude-opus-5
# CHAT_TEMPERATURE=0.4
# STT_MODEL=whisper-1
# TTS_MODEL=tts-1
# TTS_VOICE=alloy
# EMBEDDING_MODEL=text-embedding-3-small
#
# Groq's working set (chat + speech, no embeddings -- see below):
#   CHAT_MODEL=openai/gpt-oss-120b
#   STT_MODEL=whisper-large-v3-turbo
#   TTS_MODEL=canopylabs/orpheus-v1-english
#   TTS_VOICE=hannah
#   TTS_FORMAT=wav
#   EMBEDDING_MODEL=

# Container the TTS model returns. Must match what the provider actually
# emits: Orpheus on Groq is wav-only, so leaving this at the mp3 default would
# publish files whose extension lies about their bytes.
# TTS_FORMAT=wav

# Blank EMBEDDING_MODEL means "this provider has no embeddings endpoint" (Groq
# has none). RAG then hands the model the module's material unranked instead of
# spending a failing round-trip on every request. It does not disable RAG.
# EMBEDDING_MODEL=

# Blank CHAT_TEMPERATURE omits the parameter, which some reasoning models
# (e.g. AgentRouter's gpt-5.6-sol) reject instead of ignoring.
# CHAT_TEMPERATURE=

# --- Infrastructure -------------------------------------------------------
# Postgres. Use :5432 for a native install; the docker-compose service
# publishes on :5433 so it does not clash with one.
DATABASE_URL=postgresql://postgres:devpassword@localhost:5432/edubridge

# Signs the JWTs issued at login. Must be a long random string anywhere
# other than local development.
JWT_SECRET_KEY=replace-with-a-long-random-string

# Browser origins allowed to call this API, comma-separated. Needed as soon as
# the frontend and the API are not on the same machine: a deployed frontend has
# a different origin, and browsers block cross-origin calls by default. Must
# match exactly -- scheme included, no trailing slash. The default below covers
# local development only.
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-app.vercel.app
